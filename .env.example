# Variables for docker-compose.yml, in key parity with its environment blocks.
# Coolify discovers them from the compose file; set the values in its UI. For a
# plain `docker compose up`, copy this file to .env and fill in the blanks.
# Under DDEV, leave these unset: load.environment.php reads .env into PHP too.

# Image tag to run: latest, or sha-<short commit> to roll back.
IMAGE_TAG=latest

# production turns error display off. Also the Sentry environment.
DRUPAL_ENVIRONMENT=production

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
# Required, no default.
DB_PASSWORD=
# Required, no default. MariaDB's root password, used only by the mariadb service.
DB_ROOT_PASSWORD=

REDIS_HOST=valkey
REDIS_PORT=6379
VALKEY_MAXMEMORY=256mb

# Required, no default. Carry over Platform.sh's project entropy; never regenerate.
HASH_SALT=

# Comma-separated full regular expressions, used verbatim. Must match the
# health check host, or the container never becomes healthy.
TRUSTED_HOST_PATTERNS=^contrib\.axelerant\.com$

# The site URL drush uses for links it generates.
DRUSH_OPTIONS_URI=https://contrib.axelerant.com

# Host header for the health check. Defaults to the first COOLIFY_FQDN.
HEALTHCHECK_HOST=
# Set by Coolify.
COOLIFY_FQDN=

SENTRY_DSN=
SLACK_WEBHOOK_URL=

# drupal-base image options (see https://github.com/hussainweb/docker-drupal-base).
PHP_MEMORY_LIMIT=512M
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
NOINDEX_SNIPPET=/etc/frankenphp/noindex/disabled.caddy
