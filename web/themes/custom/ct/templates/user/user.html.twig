{% if content.user_picture.0 %}
  {{- content.user_picture -}}
{% endif %}
{% embed 'ct:panel' with {attributes: attributes, content: content} only %}
  {% block content %}
    <div class="panel__body">
      {% if content %}
        {{- content|without('user_picture') -}}
      {% endif %}
    </div>
  {% endblock %}
{% endembed %}
