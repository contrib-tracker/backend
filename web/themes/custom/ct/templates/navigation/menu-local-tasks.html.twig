{% if primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  {% embed 'ct:tabs' with {primary: primary} only %}
    {% block items %}{{ primary }}{% endblock %}
  {% endembed %}
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  {% embed 'ct:tabs' with {secondary: secondary} only %}
    {% block items %}{{ secondary }}{% endblock %}
  {% endembed %}
{% endif %}
