{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "jquery", "select2"]
  },
  "include": ["components/**/*.js", "js/**/*.js", "types/**/*.d.ts", "vite.config.ts"],
  "exclude": ["node_modules"]
}
